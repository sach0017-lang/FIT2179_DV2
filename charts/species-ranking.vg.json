{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 620,
  "height": 420,

  "data": {
    "url": "data/species_data_lollipop.csv",

    "format": {
      "type": "csv",
      "parse": {
        "estimated_population": "number"
      }
    }
  },

  "transform": [

    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],

      "sort": [
        {
          "field": "estimated_population",
          "order": "ascending"
        }
      ]
    }
  ],

  "encoding": {

    "y": {
      "field": "species",
      "type": "ordinal",

      "sort": {
        "field": "estimated_population",
        "order": "ascending"
      },

      "axis": {

        "title": null,

        "labelColor": "#1f2521",

        "labelFont": "Inter",

        "labelFontWeight": "bold",

        "labelFontSize": 14,

        "labelLimit": 240,

        "labelPadding": 12,

        "ticks": false,

        "domain": false
      }
    },

    "x": {

      "field": "rank",

      "type": "quantitative",

      "scale": {
        "domain": [0, 12]
      },

      "axis": null
    }
  },

  "layer": [

    {
      "mark": {

        "type": "bar",

        "height": 4,

        "color": "#6b7468",

        "cornerRadius": 4
      }
    },

    {
      "mark": {

        "type": "circle",

        "size": 1100,

        "stroke": "#4c544c",

        "strokeWidth": 2
      },

      "encoding": {

        "color": {

          "field": "status",

          "type": "nominal",

          "scale": {

            "domain": [
              "Critically Endangered",
              "Endangered"
            ],

            "range": [
              "#d6525f",
              "#eda34f"
            ]
          },

          "legend": {

            "orient": "top",

            "direction": "horizontal",

            "title": null,

            "labelColor": "#1f2521",

            "labelFont": "Inter",

            "labelFontSize": 12,

            "symbolType": "circle",

            "symbolSize": 120,

            "columns": 2,

            "offset": 6
          }
        },

        "tooltip": [

          {
            "field": "species",
            "title": "Species"
          },

          {
            "field": "estimated_population",
            "title": "Estimated Remaining Population"
          },

          {
            "field": "status",
            "title": "Conservation Status"
          },

          {
            "field": "state",
            "title": "State"
          }
        ]
      }
    },

    {
      "mark": {

        "type": "text",

        "font": "Inter",

        "fontWeight": "bold",

        "fontSize": 10,

        "color": "#f5f1e8"
      },

      "encoding": {

        "text": {
          "field": "estimated_population"
        }
      }
    }
  ],

  "config": {

    "background": "#d9d4c7",

    "view": {
      "stroke": null
    },

    "axis": {
      "grid": false
    }
  }
}