{
  "$schema": "https://vega.github.io/schema/vega/v5.json",

  "width": 980,
  "height": 560,

  "padding": {
    "top": 42,
    "left": 8,
    "right": 8,
    "bottom": 8
  },

  "background": "#d9d4c7",

  "data": [

    {
      "name": "tree",

      "url": "data/conservation_treemap.csv",

      "format": {
        "type": "csv",
        "parse": {
          "value": "number"
        }
      },

      "transform": [

        {
          "type": "stratify",

          "key": "id",

          "parentKey": "parent"
        },

        {
          "type": "treemap",

          "field": "value",

          "sort": {
            "field": "value",
            "order": "descending"
          },

          "method": "squarify",

          "round": true,

          "paddingInner": 4,

          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },

    {
      "name": "nodes",

      "source": "tree",

      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 2"
        }
      ]
    }
  ],

  "scales": [

    {
      "name": "color",

      "type": "ordinal",

      "domain": [
        "Conservation Efforts",
        "Ecological Loss"
      ],

      "range": [
        "#95a184",
        "#d66a73"
      ]
    }
  ],

  "marks": [

    {
      "type": "rect",

      "from": {
        "data": "nodes"
      },

      "encode": {

        "enter": {

          "x": {
            "field": "x0"
          },

          "y": {
            "field": "y0"
          },

          "x2": {
            "field": "x1"
          },

          "y2": {
            "field": "y1"
          },

          "fill": {
            "scale": "color",
            "field": "parent"
          },

          "stroke": {
            "value": "#f3efe5"
          },

          "strokeWidth": {
            "value": 3
          },

          "cornerRadius": {
            "value": 6
          }
        },

        "hover": {

          "fillOpacity": {
            "value": 0.88
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "nodes"
      },

      "encode": {

        "enter": {

          "x": {
            "signal": "(datum.x0 + datum.x1)/2"
          },

          "y": {
            "signal": "(datum.y0 + datum.y1)/2 - 10"
          },

          "text": {

            "signal":
              "replace(replace(datum.id,' Species ','\\nSpecies '),' Programs','\\nPrograms')"
          },

          "align": {
            "value": "center"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {

            "signal":
              "clamp((datum.x1 - datum.x0)/15, 10, 16)"
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#f8f5ed"
          },

          "limit": {
            "signal": "(datum.x1 - datum.x0) - 16"
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "nodes"
      },

      "encode": {

        "enter": {

          "x": {
            "signal": "(datum.x0 + datum.x1)/2"
          },

          "y": {
            "signal": "(datum.y0 + datum.y1)/2 + 18"
          },

          "text": {
            "signal": "datum.value"
          },

          "align": {
            "value": "center"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {
            "value": 12
          },

          "fill": {
            "value": "#f8f5ed"
          }
        }
      }
    },

    {
      "type": "rect",

      "encode": {

        "enter": {

          "x": {
            "value": 690
          },

          "y": {
            "value": -32
          },

          "width": {
            "value": 18
          },

          "height": {
            "value": 18
          },

          "fill": {
            "value": "#d66a73"
          },

          "cornerRadius": {
            "value": 3
          }
        }
      }
    },

    {
      "type": "text",

      "encode": {

        "enter": {

          "x": {
            "value": 716
          },

          "y": {
            "value": -23
          },

          "text": {
            "value": "Ecological Loss"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {
            "value": 13
          },

          "fill": {
            "value": "#1f2521"
          }
        }
      }
    },

    {
      "type": "rect",

      "encode": {

        "enter": {

          "x": {
            "value": 840
          },

          "y": {
            "value": -32
          },

          "width": {
            "value": 18
          },

          "height": {
            "value": 18
          },

          "fill": {
            "value": "#95a184"
          },

          "cornerRadius": {
            "value": 3
          }
        }
      }
    },

    {
      "type": "text",

      "encode": {

        "enter": {

          "x": {
            "value": 866
          },

          "y": {
            "value": -23
          },

          "text": {
            "value": "Conservation Efforts"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {
            "value": 13
          },

          "fill": {
            "value": "#1f2521"
          }
        }
      }
    }
  ]
}