{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 760,
  "height": 460,

  "background": "#d9d4c7",

  "data": {
    "url": "data/streamgraph_real.csv",

    "format": {
      "type": "csv",

      "parse": {
        "year": "number",
        "affected_species": "number"
      }
    }
  },

  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "opacity": 0.9
  },

  "encoding": {

    "x": {

      "field": "year",

      "type": "temporal",

      "title": "Year",

      "axis": {

        "titleColor": "#1f2521",

        "titleFont": "Inter",

        "titleFontWeight": "bold",

        "titleFontSize": 20,

        "labelColor": "#1f2521",

        "labelFont": "Inter",

        "labelFontSize": 13,

        "grid": false,

        "tickColor": "#7b8277",

        "domainColor": "#7b8277",

        "format": "%Y"
      }
    },

    "y": {

      "field": "affected_species",

      "type": "quantitative",

      "stack": "center",

      "title": "Threatened Species Affected",

      "axis": {

        "titleColor": "#1f2521",

        "titleFont": "Inter",

        "titleFontWeight": "bold",

        "titleFontSize": 20,

        "labelColor": "#1f2521",

        "labelFont": "Inter",

        "labelFontSize": 13,

        "grid": false,

        "tickColor": "#7b8277",

        "domain": false
      }
    },

    "color": {

      "field": "threat",

      "type": "nominal",

      "scale": {

        "domain": [
          "Bushfires",
          "Habitat Loss",
          "Climate Change",
          "Invasive Species",
          "Pollution"
        ],

        "range": [
          "#d6525f",
          "#b96a4a",
          "#eda34f",
          "#8b9484",
          "#687264"
        ]
      },

      "legend": {

        "orient": "top",

        "direction": "horizontal",

        "title": null,

        "labelColor": "#1f2521",

        "labelFont": "Inter",

        "labelFontSize": 13,

        "symbolType": "square",

        "symbolSize": 180,

        "columns": 3
      }
    },

    "tooltip": [

      {
        "field": "year",
        "title": "Year"
      },

      {
        "field": "threat",
        "title": "Threat Type"
      },

      {
        "field": "affected_species",
        "title": "Affected Species"
      }
    ]
  },

  "config": {

    "view": {
      "stroke": null
    }
  }
}