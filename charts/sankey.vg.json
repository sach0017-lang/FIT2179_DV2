{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 820,
  "height": 430,

  "background": "#d9d4c7",

  "data": {
    "url": "data/threat_bubble_real.csv",

    "format": {
      "type": "csv",

      "parse": {
        "affected_species": "number"
      }
    }
  },

  "layer": [

    {
      "mark": {
        "type": "circle",

        "opacity": 0.88,

        "stroke": "#1f2521",

        "strokeWidth": 2
      },

      "encoding": {

        "x": {

          "field": "threat",

          "type": "nominal",

          "sort": [
            "Bushfires",
            "Climate Change",
            "Habitat Loss",
            "Invasive Species",
            "Mining"
          ],

          "axis": {

            "title": "Environmental Threat",

            "titleColor": "#1f2521",

            "titleFont": "Inter",

            "titleFontWeight": "bold",

            "titleFontSize": 18,

            "labelColor": "#1f2521",

            "labelFont": "Inter",

            "labelFontSize": 14,

            "labelAngle": 0,

            "labelPadding": 12,

            "ticks": false,

            "domainColor": "#8f988c"
          }
        },

        "y": {

          "field": "wildlife_group",

          "type": "nominal",

          "sort": [
            "Amphibians",
            "Birds",
            "Mammals",
            "Reptiles"
          ],

          "axis": {

            "title": "Wildlife Group",

            "titleColor": "#1f2521",

            "titleFont": "Inter",

            "titleFontWeight": "bold",

            "titleFontSize": 18,

            "labelColor": "#1f2521",

            "labelFont": "Inter",

            "labelFontSize": 14,

            "labelPadding": 8,

            "ticks": false,

            "domainColor": "#8f988c"
          }
        },

        "size": {

          "field": "affected_species",

          "type": "quantitative",

          "scale": {
            "range": [2500, 8500]
          },

          "legend": null
        },

        "color": {

          "field": "severity",

          "type": "nominal",

          "scale": {

            "domain": [
              "Critical",
              "High",
              "Moderate"
            ],

            "range": [
              "#d6525f",
              "#c89f56",
              "#7f9078"
            ]
          },

          "legend": {

            "orient": "top",

            "direction": "horizontal",

            "title": null,

            "labelColor": "#1f2521",

            "labelFont": "Inter",

            "labelFontSize": 13,

            "symbolType": "circle",

            "symbolSize": 180,

            "columns": 3,

            "offset": 10
          }
        },

        "tooltip": [

          {
            "field": "threat",
            "title": "Environmental Threat"
          },

          {
            "field": "wildlife_group",
            "title": "Wildlife Group"
          },

          {
            "field": "affected_species",
            "title": "Affected Species"
          },

          {
            "field": "severity",
            "title": "Severity"
          }
        ]
      }
    },

    {
      "mark": {

        "type": "text",

        "font": "Inter",

        "fontWeight": "bold",

        "fontSize": 14,

        "color": "#1f2521",

        "align": "center",

        "baseline": "middle"
      },

      "encoding": {

        "x": {
          "field": "threat",
          "type": "nominal"
        },

        "y": {
          "field": "wildlife_group",
          "type": "nominal"
        },

        "text": {
          "field": "affected_species"
        }
      }
    }
  ],

  "config": {

    "view": {
      "stroke": null
    }
  }
}