{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 720,
  "height": 720,

  "background": "#d9d4c7",

  "data": {
    "url": "data/funding_real.csv",

    "format": {
      "type": "csv",

      "parse": {
        "funding_million": "number"
      }
    }
  },

  "layer": [

    {
      "mark": {

        "type": "arc",

        "innerRadius": 40,

        "stroke": "#f3efe4",

        "strokeWidth": 2
      },

      "encoding": {

        "theta": {

          "field": "funding_million",

          "type": "quantitative",

          "stack": true
        },

        "radius": {

          "field": "funding_million",

          "type": "quantitative",

          "scale": {
            "range": [80, 310]
          }
        },

        "color": {

          "field": "funding_million",

          "type": "quantitative",

          "scale": {

            "domain": [70, 210],

            "range": [
              "#687264",
              "#9aa16f",
              "#d8c45c",
              "#eda34f",
              "#d6525f"
            ]
          },

          "legend": {

            "title": "Funding (Million AUD)",

            "orient": "right",

            "gradientLength": 220,

            "titleColor": "#1f2521",

            "labelColor": "#1f2521",

            "titleFont": "Inter",

            "labelFont": "Inter",

            "titleFontWeight": "bold"
          }
        },

        "tooltip": [

          {
            "field": "category",
            "title": "Funding Category"
          },

          {
            "field": "funding_million",
            "title": "Funding (Million AUD)"
          }
        ]
      }
    },

    {
      "mark": {

        "type": "text",

        "radiusOffset": 25,

        "font": "Inter",

        "fontWeight": "bold",

        "fontSize": 11,

        "color": "#1f2521"
      },

      "encoding": {

        "theta": {

          "field": "funding_million",

          "type": "quantitative",

          "stack": true
        },

        "radius": {

          "field": "funding_million",

          "type": "quantitative",

          "scale": {
            "range": [80, 310]
          }
        },

        "text": {
          "field": "funding_million"
        }
      }
    }
  ],

  "config": {

    "view": {
      "stroke": null
    }
  }
}