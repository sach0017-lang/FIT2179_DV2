{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 850,
  "height": 700,

  "data": {
    "values": [

      {
        "category": "Habitat Restoration",
        "funding": 38
      },

      {
        "category": "Bushfire Recovery",
        "funding": 24
      },

      {
        "category": "Marine Protection",
        "funding": 18
      },

      {
        "category": "Research & Monitoring",
        "funding": 16
      },

      {
        "category": "Species Breeding",
        "funding": 12
      },

      {
        "category": "Anti-Poaching",
        "funding": 8
      }
    ]
  },

  "params": [

    {
      "name": "hover",

      "select": {
        "type": "point",
        "on": "mouseover",
        "clear": "mouseout"
      }
    }
  ],

  "mark": {
    "type": "arc",

    "innerRadius": 100,

    "cornerRadius": 10,

    "stroke": "#d9d4c7",

    "strokeWidth": 3
  },

  "encoding": {

    "theta": {
      "field": "funding",
      "type": "quantitative"
    },

    "radius": {
      "field": "funding",

      "scale": {
        "range": [120, 250]
      }
    },

    "color": {

      "field": "category",

      "type": "nominal",

      "scale": {
        "range": [
          "#6f8f6b",
          "#8b9a7d",
          "#d8c45c",
          "#f08c3b",
          "#c96a3d",
          "#c91f37"
        ]
      },

      "legend": {

        "orient": "left",

        "title": "Funding Allocation",

        "direction": "vertical",

        "labelColor": "#3f4a43",

        "titleColor": "#3f4a43",

        "labelFont": "Inter",

        "titleFont": "Inter",

        "labelFontSize": 17,

        "titleFontSize": 21,

        "symbolSize": 320,

        "symbolType": "circle",

        "padding": 24,

        "titleLimit": 500,

        "labelLimit": 220
      }
    },

    "opacity": {

      "condition": {
        "param": "hover",
        "value": 1
      },

      "value": 0.72
    },

    "tooltip": [

      {
        "field": "category",
        "title": "Conservation Area"
      },

      {
        "field": "funding",
        "title": "Funding Allocation (%)"
      }
    ]
  },

  "config": {

    "background": "#d9d4c7",

    "view": {
      "stroke": null
    }
  }
}