{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 800,
  "height": 500,

  "projection": {
    "type": "mercator"
  },

  "data": {
    "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
    "format": {
      "type": "topojson",
      "feature": "countries"
    }
  },

  "transform": [
    {
      "filter": "datum.id == 36"
    }
  ],

  "mark": {
    "type": "geoshape",
    "fill": "#d97706",
    "stroke": "white",
    "strokeWidth": 1.5
  },

  "encoding": {
    "tooltip": [
      {
        "value": "Australia"
      }
    ]
  },

  "config": {
    "background": "#cfd8cf"
  }
}