{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 750,
  "height": 600,

  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  
  "projection": {
    "type": "mercator"
  },

  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",

    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [

    {
      "lookup": "properties.STATE_NAME",

      "from": {

        "data": {

          "url": "data/map_real_data.csv",

          "format": {
            "type": "csv"
          }
        },

        "key": "state",

        "fields": [
          "threatened_species",
          "severity"
        ]
      }
    }
  ],

  "mark": {
    "type": "geoshape",

    "stroke": "#f3f1ea",

    "strokeWidth": 1.5
  },

  "encoding": {

    "color": {

      "field": "threatened_species",

      "type": "quantitative",

      "title": "Threatened Species Count",

      "scale": {

        "domain": [150, 1050],

        "range": [
          "#6f8f6b",
          "#d8c45c",
          "#f08c3b",
          "#c91f37"
        ]
      },

      "legend": {

        "orient": "bottom",

        "gradientLength": 400,

        "gradientThickness": 18,

        "labelColor": "#3f4a43",

        "titleColor": "#3f4a43",

        "titleLimit": 500,

        "labelFontSize": 15,

        "titleFontSize": 18
      }
    },

    "tooltip": [

      {
        "field": "properties.STATE_NAME",
        "title": "State"
      },

      {
        "field": "threatened_species",
        "title": "Threatened Species"
      },

      {
        "field": "severity",
        "title": "Severity"
      }
    ],

    "opacity": {

      "condition": {
        "selection": "hover",
        "value": 1
      },

      "value": 0.82
    }
  },

  "selection": {

    "hover": {
      "type": "single",
      "on": "mouseover",
      "empty": "none"
    }
  },

  "config": {

    "background": "#d9d4c7",

    "view": {
      "stroke": null
    }
  }
}