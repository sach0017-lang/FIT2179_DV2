{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 820,
  "height": 180,

  "background": "#d9d4c7",

  "data": {
    "url": "data/ridgeline_real.csv",

    "format": {
      "type": "csv",

      "parse": {
        "decline_index": "number"
      }
    }
  },

  "transform": [

    {
      "density": "decline_index",

      "groupby": ["ecosystem"],

      "extent": [20, 100],

      "steps": 200,

      "bandwidth": 5,

      "as": ["decline_index", "density"]
    },

    {
      "calculate":
        "datum.ecosystem == 'Coral Reefs' ? 0.22 : datum.ecosystem == 'Alpine Regions' ? 0.18 : datum.ecosystem == 'Wetlands' ? 0.14 : datum.ecosystem == 'Temperate Forests' ? 0.10 : datum.ecosystem == 'Grasslands' ? 0.06 : 0.02",

      "as": "offset"
    },

    {
      "calculate": "(datum.density * 2.8) + datum.offset",

      "as": "stacked_density"
    }
  ],

  "mark": {

    "type": "area",

    "interpolate": "monotone",

    "fillOpacity": 0.88,

    "stroke": "#3f4740",

    "strokeWidth": 1.5
  },

  "encoding": {

    "x": {

      "field": "decline_index",

      "type": "quantitative",

      "title": "Ecological Decline Severity Index",

      "scale": {
        "domain": [20, 100]
      },

      "axis": {

        "titleColor": "#1f2521",

        "titleFont": "Inter",

        "titleFontWeight": "bold",

        "titleFontSize": 16,

        "labelColor": "#1f2521",

        "labelFont": "Inter",

        "labelFontSize": 11,

        "grid": false,

        "domainColor": "#5f675d",

        "domainWidth": 1.5,

        "tickColor": "#5f675d",

        "tickSize": 5
      }
    },

    "y": {

      "field": "stacked_density",

      "type": "quantitative",

      "scale": {
        "domain": [0, 0.34]
      },

      "axis": null
    },

    "color": {

      "field": "ecosystem",

      "type": "nominal",

      "scale": {

        "domain": [
          "Coral Reefs",
          "Alpine Regions",
          "Wetlands",
          "Temperate Forests",
          "Grasslands",
          "Arid Ecosystems"
        ],

        "range": [
          "#d85b68",
          "#e58957",
          "#eda94d",
          "#bfb46d",
          "#9da385",
          "#7a8477"
        ]
      },

      "legend": {

        "orient": "top",

        "direction": "horizontal",

        "title": null,

        "labelColor": "#1f2521",

        "labelFont": "Inter",

        "labelFontSize": 11,

        "columns": 3,

        "symbolType": "circle",

        "symbolSize": 100
      }
    },

    "order": {

      "field": "offset",

      "sort": "ascending"
    },

    "tooltip": [

      {
        "field": "ecosystem",
        "title": "Ecosystem"
      },

      {
        "field": "decline_index",
        "title": "Decline Severity"
      }
    ]
  },

  "config": {

    "view": {
      "stroke": null
    }
  }
}