{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 720,
  "height": 470,

  "background": "#d9d4c7",

  "data": {
    "url": "data/bushfire_scatter_real.csv",

    "format": {
      "type": "csv",

      "parse": {
        "bushfire_intensity": "number",
        "species_decline": "number"
      }
    }
  },

  "layer": [

    {
      "transform": [
        {
          "regression": "species_decline",
          "on": "bushfire_intensity"
        }
      ],

      "mark": {
        "type": "line",

        "stroke": "#4c544c",

        "strokeWidth": 2.5,

        "strokeDash": [4, 8],

        "opacity": 0.75
      },

      "encoding": {

        "x": {
          "field": "bushfire_intensity",
          "type": "quantitative"
        },

        "y": {
          "field": "species_decline",
          "type": "quantitative"
        }
      }
    },

    {
      "mark": {

        "type": "circle",

        "size": 520,

        "stroke": "#2f352f",

        "strokeWidth": 1.5,

        "opacity": 0.95
      },

      "encoding": {

        "x": {

          "field": "bushfire_intensity",

          "type": "quantitative",

          "title": "Bushfire Intensity Index",

          "scale": {
            "domain": [40, 100]
          },

          "axis": {

            "titleColor": "#1f2521",

            "titleFont": "Inter",

            "titleFontWeight": "bold",

            "titleFontSize": 20,

            "labelColor": "#1f2521",

            "labelFont": "Inter",

            "labelFontSize": 13,

            "grid": false,

            "domainColor": "#7b8277",

            "tickColor": "#7b8277"
          }
        },

        "y": {

          "field": "species_decline",

          "type": "quantitative",

          "title": "Estimated Species Decline (%)",

          "scale": {
            "domain": [20, 100]
          },

          "axis": {

            "titleColor": "#1f2521",

            "titleFont": "Inter",

            "titleFontWeight": "bold",

            "titleFontSize": 20,

            "labelColor": "#1f2521",

            "labelFont": "Inter",

            "labelFontSize": 13,

            "grid": false,

            "domainColor": "#7b8277",

            "tickColor": "#7b8277"
          }
        },

        "color": {

          "field": "severity",

          "type": "nominal",

          "scale": {

            "domain": [
              "Critical",
              "High",
              "Moderate"
            ],

            "range": [
              "#d6525f",
              "#eda34f",
              "#8b9484"
            ]
          },

          "legend": {

            "orient": "top",

            "direction": "horizontal",

            "title": null,

            "labelColor": "#1f2521",

            "labelFont": "Inter",

            "labelFontSize": 14,

            "symbolType": "circle",

            "symbolSize": 180,

            "columns": 3
          }
        },

        "tooltip": [

          {
            "field": "state",
            "title": "State"
          },

          {
            "field": "bushfire_intensity",
            "title": "Bushfire Intensity"
          },

          {
            "field": "species_decline",
            "title": "Species Decline (%)"
          },

          {
            "field": "severity",
            "title": "Severity"
          }
        ]
      }
    },

    {
      "mark": {

        "type": "text",

        "align": "left",

        "dx": 18,

        "dy": 0,

        "font": "Inter",

        "fontWeight": "bold",

        "fontSize": 11,

        "color": "#1f2521"
      },

      "encoding": {

        "x": {
          "field": "bushfire_intensity",
          "type": "quantitative"
        },

        "y": {
          "field": "species_decline",
          "type": "quantitative"
        },

        "text": {
          "field": "state"
        }
      }
    }
  ],

  "config": {

    "view": {
      "stroke": null
    }
  }
}