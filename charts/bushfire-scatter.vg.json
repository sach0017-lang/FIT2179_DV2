  "layer": [

    {
      "mark": {
        "type": "circle",
        "opacity": 0.88,
        "stroke": "#f3f1ea",
        "strokeWidth": 1.2
      },

      "encoding": {

        "x": {
          "field": "fire_intensity",
          "type": "quantitative",

          "title": "Bushfire Intensity",

          "scale": {
            "domain": [20,100]
          },

          "axis": {
            "labelColor": "#3f4a43",
            "titleColor": "#3f4a43",
            "gridColor": "#444"
          }
        },

        "y": {
          "field": "species_decline",
          "type": "quantitative",

          "title": "Species Decline (%)",

          "axis": {
            "labelColor": "#3f4a43",
            "titleColor": "#3f4a43",
            "gridColor": "#444"
          }
        },

        "size": {
          "field": "hectares",
          "type": "quantitative",

          "title": "Hectares Burned",

          "scale": {
            "range": [150, 2000]
          }
        },

        "color": {
          "field": "region",
          "type": "nominal",

          "scale": {
            "range": [
              "#607466",
              "#8b9a7d",
              "#d6a85f",
              "#9f6b53",
              "#748c70"
            ]
          },

        "legend": {
            "orient": "bottom",

            "direction": "horizontal",

            "labelColor": "#3f4a43",

            "titleColor": "#3f4a43",

            "padding": 15
        }
        },

        "tooltip": [
          {
            "field": "region"
          },

          {
            "field": "fire_intensity",
            "title": "Intensity"
          },

          {
            "field": "species_decline",
            "title": "Species Decline (%)"
          },

          {
            "field": "hectares",
            "title": "Hectares Burned"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "line",
        "color": "#d6a85f",
        "strokeWidth": 3,
        "opacity": 0.7
      },

      "transform": [
        {
          "regression": "species_decline",
          "on": "fire_intensity"
        }
      ],

      "encoding": {

        "x": {
          "field": "fire_intensity",
          "type": "quantitative"
        },

        "y": {
          "field": "species_decline",
          "type": "quantitative"
        }
      }
    }
  ],

  "config": {

    "background": "#d9d4c7",

    "view": {
      "stroke": null
    }
  }
}