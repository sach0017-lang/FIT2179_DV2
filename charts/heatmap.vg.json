{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 620,
  "height": 420,

  "data": {
    "url": "data/threatened_species_heatmap.csv",

    "format": {
      "type": "csv",
      "parse": {
        "threatened_species_count": "number"
      }
    }
  },

  "params": [
    {
      "name": "groupFilter",
      "value": "All Groups"
    }
  ],

  "transform": [
    {
      "calculate": "groupFilter === 'All Groups' ? 1 : datum.wildlife_group === groupFilter ? 1 : 0.18",
      "as": "opacityValue"
    }
  ],

  "layer": [

    {
      "mark": {
        "type": "rect",
        "cornerRadius": 4
      },

      "encoding": {

        "x": {
          "field": "wildlife_group",

          "type": "nominal",

          "sort": [
            "Amphibians",
            "Birds",
            "Mammals",
            "Reptiles"
          ],

          "title": "Wildlife Group",

          "axis": {
            "labelColor": "#3f4a43",
            "titleColor": "#3f4a43",
            "labelFontSize": 16,
            "titleFontSize": 18,
            "labelAngle": 0
          }
        },

        "y": {
          "field": "state",

          "type": "nominal",

          "title": "Australian State",

          "axis": {
            "labelColor": "#3f4a43",
            "titleColor": "#3f4a43",
            "labelFontSize": 16,
            "titleFontSize": 18
          }
        },

        "color": {

          "field": "threatened_species_count",

          "type": "quantitative",

          "title": "Threatened Species Count",

          "scale": {
            "domain": [10, 95],

            "range": [
              "#6f8f6b",
              "#d8c45c",
              "#f08c3b",
              "#c91f37"
            ]
          },

          "legend": {
            "orient": "bottom",
            "gradientLength": 420,
            "gradientThickness": 18,
            "labelColor": "#3f4a43",
            "titleColor": "#3f4a43",
            "labelFontSize": 15,
            "titleFontSize": 18,
            "padding": 28
          }
        },

        "opacity": {
            "field": "opacityValue",
            "legend": null,

            "scale": {
                "domain": [0.18, 1],
                "range": [0.18, 1]
            }
        },

        "tooltip": [

          {
            "field": "state",
            "title": "State"
          },

          {
            "field": "wildlife_group",
            "title": "Wildlife Group"
          },

          {
            "field": "threatened_species_count",
            "title": "Threatened Species"
          }
        ]
      }
    },

    {
      "mark": {

        "type": "text",

        "font": "Inter",

        "fontSize": 16,

        "fontWeight": "bold",

        "color": "#fffaf2",

        "stroke": "#000000",

        "strokeOpacity": 0.15,

        "strokeWidth": 0.6
      },

      "encoding": {

        "x": {
          "field": "wildlife_group",
          "type": "nominal"
        },

        "y": {
          "field": "state",
          "type": "nominal"
        },

        "text": {
          "field": "threatened_species_count"
        },

      "opacity": {
        "field": "opacityValue",
        "legend": null,

        "scale": {
            "domain": [0.18, 1],
            "range": [0.18, 1]
        }
       }
      }
    }
  ],

  "config": {

    "background": "#d9d4c7",

    "view": {
      "stroke": null
    }
  }
}