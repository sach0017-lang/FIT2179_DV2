{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 1250,
  "height": 360,

  "background": "#d9d4c7",

  "padding": {
    "left": 40,
    "right": 40,
    "top": 20,
    "bottom": 40
  },

  "data": {
    "url": "data/timeline_real.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number"
      }
    }
  },

  "transform": [

    {
      "calculate":
        "datum.year == 1996 || datum.year == 2006 || datum.year == 2015 || datum.year == 2019 || datum.year == 2021 || datum.year == 2023",
      "as": "top_event"
    }

  ],

  "layer": [

    {
      "mark": {
        "type": "line",
        "stroke": "#556056",
        "strokeWidth": 3
      },

      "encoding": {

        "x": {

          "field": "year",

          "type": "ordinal",

          "sort": null,

          "scale": {
            "padding": 0.65
          },

          "axis": {

            "title": "Year",

            "titleColor": "#1f2521",

            "titleFont": "Inter",

            "titleFontWeight": "bold",

            "titleFontSize": 16,

            "titlePadding": 28,

            "labelAngle": 0,

            "labelColor": "#1f2521",

            "labelFont": "Inter",

            "labelFontWeight": "bold",

            "labelFontSize": 18,

            "labelPadding": 16,

            "ticks": true,

            "tickColor": "#556056",

            "tickSize": 8,

            "domainColor": "#7a8177",

            "domainWidth": 1.2
          }
        },

        "y": {
          "value": 180
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.top_event"
        }
      ],

      "mark": {

        "type": "tick",

        "orient": "vertical",

        "size": 120,

        "thickness": 2,

        "color": "#7a8177"
      },

      "encoding": {

        "x": {
          "field": "year",
          "type": "ordinal",
          "scale": {
            "padding": 0.65
          }
        },

        "y": {
          "value": 120
        }
      }
    },

    {
      "transform": [
        {
          "filter": "!datum.top_event"
        }
      ],

      "mark": {

        "type": "tick",

        "orient": "vertical",

        "size": 120,

        "thickness": 2,

        "color": "#7a8177"
      },

      "encoding": {

        "x": {
          "field": "year",
          "type": "ordinal",
          "scale": {
            "padding": 0.65
          }
        },

        "y": {
          "value": 240
        }
      }
    },

    {
      "mark": {

        "type": "circle",

        "size": 360,

        "stroke": "#2f352f",

        "strokeWidth": 2.2
      },

      "encoding": {

        "x": {
          "field": "year",
          "type": "ordinal",

          "scale": {
            "padding": 0.65
          }
        },

        "y": {
          "value": 180
        },

        "color": {

          "field": "impact_level",

          "type": "nominal",

          "scale": {

            "domain": [
              "Critical",
              "High",
              "Moderate"
            ],

            "range": [
              "#d85b68",
              "#eda94d",
              "#b2b78f"
            ]
          },

          "legend": {

            "orient": "top",

            "direction": "horizontal",

            "title": null,

            "labelColor": "#1f2521",

            "labelFont": "Inter",

            "labelFontSize": 15,

            "symbolType": "circle",

            "symbolSize": 180,

            "columns": 3
          }
        },

        "tooltip": [

          {
            "field": "year",
            "title": "Year"
          },

          {
            "field": "event",
            "title": "Event"
          },

          {
            "field": "impact_level",
            "title": "Impact"
          },

          {
            "field": "category",
            "title": "Category"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.top_event"
        }
      ],

      "mark": {

        "type": "text",

        "font": "Inter",

        "fontWeight": "bold",

        "fontSize": 11,

        "align": "center",

        "baseline": "bottom",

        "lineBreak": "\n",

        "color": "#1f2521"
      },

      "encoding": {

        "x": {
          "field": "year",
          "type": "ordinal",

          "scale": {
            "padding": 0.65
          }
        },

        "y": {
          "value": 70
        },

        "text": {
          "field": "short_label"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "!datum.top_event"
        }
      ],

      "mark": {

        "type": "text",

        "font": "Inter",

        "fontWeight": "bold",

        "fontSize": 11,

        "align": "center",

        "baseline": "top",

        "lineBreak": "\n",

        "color": "#1f2521"
      },

      "encoding": {

        "x": {
          "field": "year",
          "type": "ordinal",

          "scale": {
            "padding": 0.65
          }
        },

        "y": {
          "value": 292
        },

        "text": {
          "field": "short_label"
        }
      }
    }

  ],

  "config": {

    "view": {
      "stroke": null
    },

    "axis": {
      "grid": false
    }
  }
}